# Postgres connection string (Supabase, Neon, or any Postgres host)
DATABASE_URL=

# Private GitHub repo that publishes the forecast/actuals CSVs this app reads
GITHUB_TOKEN=

# Optional: results-email notifications (see maybe_send_results_email() in
# app.py). Sent via Gmail SMTP using an App Password -- NOT your normal
# Gmail password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for that Google account).
# If either of these is left blank, the app just skips sending -- nothing
# else breaks.
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
